{
	"name": "@npmax/app-shell",
	"version": "3.4.5",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": {
			"style": "./src/styles.css",
			"import": "./src/styles.css",
			"default": "./src/styles.css"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "echo ok",
		"test": "echo ok"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@npmax/core": "workspace:*",
		"@npmax/types": "workspace:*",
		"@npmax/ui": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^7.0.2"
	}
}
