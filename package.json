{
	"name": "npmax",
	"private": true,
	"version": "3.4.4",
	"description": "npMax — cross-platform dependency and installed app update manager",
	"license": "MIT",
	"homepage": "https://npmax.vercel.app/",
	"repository": {
		"type": "git",
		"url": "https://github.com/mehdiraized/npmax.git"
	},
	"bugs": {
		"url": "https://github.com/mehdiraized/npmax/issues"
	},
	"author": {
		"name": "mehdi rezaei",
		"email": "mehdiraized@gmail.com",
		"url": "http://mehd.ir"
	},
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"dev:web": "pnpm --filter @npmax/web dev",
		"dev:desktop": "pnpm --filter @npmax/desktop tauri dev",
		"dev:mcp": "pnpm --filter @npmax/mcp dev",
		"build": "turbo run build",
		"build:web": "pnpm --filter @npmax/web build",
		"build:desktop": "pnpm --filter @npmax/desktop tauri build",
		"build:mcp": "pnpm --filter @npmax/mcp build",
		"lint": "turbo run lint",
		"test": "pnpm --filter @npmax/core test && pnpm --filter @npmax/desktop test && pnpm --filter @npmax/desktop test:rust",
		"typecheck": "turbo run typecheck",
		"version:bump": "node scripts/bump-version.js",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,mjs,cjs}": [
			"node --check"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"turbo": "^2.10.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"postcss": "^8.5.18",
			"sharp": "^0.35.3",
			"@hono/node-server": "^2.0.12"
		}
	}
}
